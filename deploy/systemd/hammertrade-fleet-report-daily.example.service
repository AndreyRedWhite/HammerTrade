# Generates the daily fleet report (markdown) across all paper/sandbox services.
# Read-only: reads SQLite DBs + status JSON + systemctl. Places no orders.
#
# Install (with the .timer):
#   sudo cp deploy/systemd/hammertrade-fleet-report-daily.example.service /etc/systemd/system/hammertrade-fleet-report-daily.service
#   sudo cp deploy/systemd/hammertrade-fleet-report-daily.example.timer /etc/systemd/system/hammertrade-fleet-report-daily.timer
#   sudo systemctl daemon-reload && sudo systemctl enable --now hammertrade-fleet-report-daily.timer

[Unit]
Description=HammerTrade daily fleet report
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hammertrade
ExecStart=/opt/hammertrade/.venv/bin/python scripts/generate_fleet_report.py --period daily --latest-symlink
User=vorontsov
