# HammerTrade Paper Trader — BRQ6 ORB SHORT (no real orders, READONLY_TOKEN only).
#
# Install:
#   sudo cp deploy/systemd/hammertrade-paper-orb-brq6.example.service /etc/systemd/system/hammertrade-paper-orb-brq6.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now hammertrade-paper-orb-brq6

[Unit]
Description=HammerTrade Paper Trader — BRQ6 ORB SHORT (paper only, no real orders)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hammertrade
EnvironmentFile=/opt/hammertrade/.env
ExecStart=/opt/hammertrade/.venv/bin/python scripts/run_orb_paper_trader.py \
    --ticker BRQ6 \
    --class-code SPBFUT \
    --timeframe 1m \
    --direction SHORT \
    --point-value-rub 734.39 \
    --opening-range-start 10:00 \
    --opening-range-end 11:00 \
    --take-r 2.0 \
    --state-db data/paper/paper_state_brq6_orb_short.sqlite \
    --status-file runtime/paper_status_BRQ6_ORB_SHORT.json \
    --csv-output out/paper/paper_trades_BRQ6_ORB_SHORT.csv \
    --log-file logs/paper_BRQ6_ORB_SHORT.log \
    --experiment-name orb_brq6_short \
    --env prod \
    --market-hours-config configs/market_hours/moex_futures.yaml \
    --api-timeout-sec 10
Restart=always
RestartSec=10
User=vorontsov

[Install]
WantedBy=multi-user.target
