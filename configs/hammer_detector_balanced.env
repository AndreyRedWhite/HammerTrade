S_BODY_MIN_FRAC=0.12
S_BODY_MAX_FRAC=0.33
S_WICK_MULT=2.3
S_OPP_WICK_MAX_FRAC=0.70
S_WICK_DOM_RATIO=2.0
S_EXT_WINDOW=5
S_EXT_EPS_TICKS=1.0
S_NEIGHBOR_MODE=left_or_right
S_NEIGHBOR_EPS_TICKS=1.0
S_MIN_RANGE_TICKS=2.0
S_MIN_WICK_TICKS=1.5
S_OPP_WICK_MAX_ABS_TICKS=2.0
S_CLOSE_POS_FRAC=0.60
S_SILHOUETTE_MIN_FRAC=0.45
S_MIN_EXCURSION_TICKS=2.0
S_EXCURSION_HORIZON=2
S_FALLBACK_TICK=0.5
S_CLEARING_ENABLE=1
S_CONFIRM_MODE=break
S_CONFIRM_HORIZON=1
S_COOLDOWN_BARS=3
# SiU6 step value is 1 RUB/point (contract = 1000 USD, step 1 RUB), NOT 10.
# point_value=10 overstated all Si PnL 10x. See [[sandbox-vs-paper-loss-rootcause]].
POINT_VALUE_RUB=1
# Real T-Bank futures commission = 0.025% of contract value per leg (lowest
# daily-volume tier). At SiU6 notional ~76,400 RUB that's ~19 RUB/leg (~38/round
# trip). The engine charges commission_per_trade * 2. Was 0.025 (i.e. ~0 RUB).
COMMISSION_PER_TRADE=19
COMMISSION_ROUND_TURN=38
CLEARING_BLOCK_BEFORE_MIN=5
CLEARING_BLOCK_AFTER_MIN=5
TIMEZONE=Europe/Moscow
