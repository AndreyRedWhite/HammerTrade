# T-Bank API tokens
# Real token with read-only access to prod contour.
READONLY_TOKEN=

# Sandbox token for sandbox contour.
SANDBOX_TOKEN=

# Sandbox account id (filled in by scripts/sandbox_account_setup.py).
SANDBOX_ACCOUNT_ID=

# Prefer one sandbox account per multi-position strategy so reconciliation can
# treat every unexpected position as a real fault rather than another service.
SANDBOX_ACCOUNT_ID_ORB=
SANDBOX_ACCOUNT_ID_ORB_V2=
SANDBOX_ACCOUNT_ID_PAIRS=
SANDBOX_ACCOUNT_ID_PAIRS_V2=
SANDBOX_ACCOUNT_ID_CARRY=
SANDBOX_ACCOUNT_ID_VOLBREAK=
SANDBOX_ACCOUNT_ID_XSEC=

# Environment mode for T-Bank connection.
# Allowed values: prod, sandbox
TBANK_ENV=prod

# API targets.
TBANK_PROD_TARGET=invest-public-api.tbank.ru:443
TBANK_SANDBOX_TARGET=sandbox-invest-public-api.tbank.ru:443

# Safety flags.
LIVE_TRADING_ENABLED=false
SANDBOX_TRADING_ENABLED=false
SANDBOX_ORB_ENABLED=false
SANDBOX_ORB_V2_ENABLED=false
SANDBOX_PAIRS_ENABLED=false
SANDBOX_PAIRS_V2_ENABLED=false
SANDBOX_CARRY_ENABLED=false
SANDBOX_VOLBREAK_ENABLED=false
SANDBOX_XSEC_ENABLED=false

# Optional: isolated CA bundle for T-Bank gRPC/HTTPS connections.
# Use only for the HammerTrade process, not system-wide.
# Build the bundle with: bash scripts/build_tbank_ca_bundle.sh --help
# Do not disable TLS verification. Do not install Russian Trusted Root CA globally.
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=

# Telegram fleet alerting (scripts/check_all_paper_status.py --telegram).
# Create a bot via @BotFather, get your chat id via @userinfobot.
# Both unset = alerting silently disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
